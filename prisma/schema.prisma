  timezone                 String                          @default("Asia/Kuwait")
  isActive                 Boolean                         @default(true)
  members                  CompanyMember[]
  customers                Customer[]
  customerSequence         CustomerSequence?
  units                    Unit[]
  catalogItems             CatalogItem[]
  catalogItemLocalizations CatalogItemLocalization[]
  catalogCategories        CatalogCategory[]
  taxRates                 TaxRate[]
  priceLists               PriceList[]
  quotations               Quotation[]
  salesOrders              SalesOrder[]
  salesOrderActivities     SalesOrderActivity[]
  quotationDeliveries      QuotationDelivery[]
  quotationTermsTemplates  CompanyQuotationTermsTemplate[]
  contracts                Contract[]
  contractNumberSequences  ContractNumberSequence[]
  invoices                 Invoice[]
  invoiceNumberSequences   InvoiceNumberSequence[]
  payments                 Payment[]
  invoiceEvents            InvoiceEvent[]
  authorizedSignatories    AuthorizedSignatory[]
  drawingTakeoffSessions   DrawingTakeoffSession[]
  sourceArtifacts          SourceArtifact[]
  citations                Citation[]
  artifactDerivations      ArtifactDerivation[]
  crossDocumentClaims      NormalizedEvidenceClaim[]
  crossDocumentMaterializations CrossDocumentMaterialization[]
  comparisonScopes         ComparisonScope[]
  comparisonScopeArtifacts ComparisonScopeArtifact[]
  comparisonRuns           ComparisonRun[]
  subjectMatches           SubjectMatch[]
  subjectClusters          SubjectCluster[]
  crossDocumentFindings    CrossDocumentFinding[]
  findingReviewEvents      FindingReviewEvent[]
  documentIdentities       DocumentIdentity[]
  documentRevisionMemberships DocumentRevisionMembership[]
  documentRelations        DocumentRelation[]
  activeRevisionDecisions  ActiveRevisionDecision[]
  findingEvidenceObservations FindingEvidenceObservation[]
  /// Phase 2A-11 engineering takeoff + governed Engineering BOM.
  engineeringTakeoffScopes EngineeringTakeoffScope[]
  engineeringCountingRules EngineeringCountingRule[]
  engineeringOccurrenceLedgerEntries EngineeringOccurrenceLedgerEntry[]
  engineeringQuantityCandidates EngineeringQuantityCandidate[]
  engineeringCandidateSources EngineeringQuantityCandidateSource[]
  engineeringCandidateConflicts EngineeringCandidateConflict[]
  engineeringQuantityDecisions EngineeringQuantityDecision[]
  engineeringDecisionSources EngineeringQuantityDecisionSource[]
  engineeringDecisionClaims EngineeringQuantityDecisionClaim[]
  engineeringCalculations  EngineeringCalculation[]
  engineeringCalculationInputs EngineeringCalculationInput[]
  engineeringAdjustments   EngineeringAdjustment[]
  engineeringBomVersions   EngineeringBomVersion[]
  engineeringBomVersionDecisions EngineeringBomVersionDecision[]
  engineeringBomRows       EngineeringBomRow[]
  engineeringBomRowConstraints EngineeringBomRowConstraint[]
  engineeringBomRowAdjustments EngineeringBomRowAdjustment[]
  engineeringBomRequiredSubjects EngineeringBomRequiredSubject[]
  requirements             Requirement[]
  universalAdoptions       UniversalItemAdoption[]
  universalLibrarySectors  CompanyUniversalLibrarySector[]
  localizedContents        LocalizedContent[]
