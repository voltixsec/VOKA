model CatalogCategory {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Unit {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  nameAr    String?
  nameEn    String?
  symbol    String
  isActive  Boolean @default(true)

  company Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, symbol])
  @@index([companyId])
  @@index([name])
  @@index([isActive])
}

model TaxRate {
  id         String  @id @default(cuid())
  companyId  String?
  name       String
  percentage Decimal @db.Decimal(5, 2)
  isSystem   Boolean @default(false)
  isActive   Boolean @default(true)

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           CatalogItem[]
  quotationLines  QuotationLine[]
  salesOrderLines SalesOrderLine[]
  contractLines   ContractLine[]
  invoiceLines    InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isSystem])
  @@index([isActive])
}

model CatalogItem {
  id String @id @default(cuid())

  companyId String

  categoryId String?

  unitId String?

  taxRateId String?

  type CatalogItemType

  code    String
  sku     String?
  barcode String?

  name          String
  nameAr        String?
  nameEn        String?
  description   String?
  descriptionAr String?
  descriptionEn String?

  purchasePrice Decimal? @db.Decimal(18, 3)
  salePrice     Decimal? @db.Decimal(18, 3)

  trackInventory Boolean @default(true)
  allowDiscount  Boolean @default(true)

  imageUrl String?
  notes    String?

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category CatalogCategory? @relation(fields: [categoryId], references: [id])

  unit Unit? @relation(fields: [unitId], references: [id])

  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  priceListItems    PriceListItem[]
  localizations     CatalogItemLocalization[]
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]
  contractLines     ContractLine[]
  invoiceLines      InvoiceLine[]
  universalAdoption UniversalItemAdoption?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([barcode])
}

