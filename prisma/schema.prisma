generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN
  AR
}

enum CompanyRole {
  OWNER
  ADMIN
  SALES
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  defaultLocale   Locale          @default(EN)
  defaultCurrency String          @default("KWD")
  timezone        String          @default("Asia/Kuwait")
  isActive        Boolean         @default(true)
  members         CompanyMember[]
  customers       Customer[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([name])
  @@index([isActive])
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String?
  locale       Locale          @default(EN)
  isActive     Boolean         @default(true)
  memberships  CompanyMember[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive])
}

model CompanyMember {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole      @default(SALES)
  status    MembershipStatus @default(ACTIVE)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model Customer {
  id                String         @id @default(cuid())
  companyId         String
  code              String
  type              CustomerType   @default(COMPANY)
  status            CustomerStatus @default(LEAD)
  name              String
  legalName         String?
  email             String?
  phone             String?
  mobile            String?
  taxNumber         String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  countryCode       String?
  preferredLocale   Locale?
  preferredCurrency String?
  creditLimit       Decimal?       @db.Decimal(18, 3)
  paymentTermDays   Int?
  notes             String?
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, isDeleted])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, taxNumber])
}
