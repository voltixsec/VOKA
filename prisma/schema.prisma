generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyBrandTheme {
  NAVY_GOLD
  ROYAL_BLUE
  EMERALD
  BURGUNDY
  CHARCOAL
}

enum Locale {
  EN
  AR
}

enum CompanyRole {
  OWNER
  ADMIN
  SALES
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SourceArtifactContext {
  SALES_ASSISTANT
  TAKEOFF
  ENGINEERING_TENDER
}

enum SourceArtifactKind {
  PDF
  IMAGE
  /// Phase 2A-6: structured .xlsx workbooks (Excel / BOQ intelligence).
  XLSX
  /// Phase 2A-7: ASCII DXF drawings (CAD intelligence). Binary DXF is
  /// not a supported kind; it is detected and rejected truthfully at ingest.
  DXF
  /// Phase 2A-8: textual IFC STEP / BIM intelligence. IFCZIP, binary IFC,
  /// and RFA are not a supported kind; they are detected and rejected
  /// truthfully at ingest.
  IFC
  /// Phase 2A-9: a proprietary binary DWG ORIGINAL artifact. Its bytes are kept
  /// immutable and are never semantically parsed; a governed ArtifactDerivation
  /// links it to a separately stored DXF artifact that the 2A-7 CAD
  /// intelligence inspects.
  DWG
  /// Phase 2A-9: a proprietary Revit project (RVT) ORIGINAL artifact. Its bytes
  /// are kept immutable and are never semantically parsed; a governed
  /// ArtifactDerivation links it to a separately stored IFC artifact that the
  /// 2A-8 BIM intelligence inspects.
  RVT
}

enum SourceArtifactProcessingState {
  RECEIVED
  TEXT_EXTRACTED
  STORED_PENDING_VISION
  DRAWING_VISUAL_ANALYSIS_NOT_AVAILABLE
  FAILED
}

/// Phase 2A-9: how a derived artifact came to exist.
enum ArtifactDerivationKind {
  /// A proprietary binary DWG original was derived into an ASCII DXF artifact.
  DWG_TO_DXF
  /// A proprietary Revit project original was derived into a textual IFC artifact.
  RVT_TO_IFC
}

/// Phase 2A-9: who produced the derived bytes. The two channels must never be
/// confused: an automated conversion records a converter identity; a
/// user-provided export records none and VOKA never claims it converted.
enum ArtifactDerivationMethod {
  /// A ConversionProvider converted the bytes inside VOKA.
  AUTOMATED_CONVERSION
  /// The user exported the derived file externally and explicitly linked it to
  /// the original artifact.
  USER_PROVIDED_EXPORT
}

/// Phase 2A-9: lifecycle of one derivation.
enum ArtifactDerivationStatus {
  PENDING
  RUNNING
  AWAITING_USER_EXPORT
  SUCCEEDED
  FAILED
  NOT_CONFIGURED
  REJECTED
}

enum RequirementQuantityStatus {
  USER_PROVIDED
  EXTRACTED_REVIEW_REQUIRED
  DETERMINISTIC
  UNKNOWN
}

enum RequirementReviewState {
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id                       String                          @id @default(cuid())
  name                     String
  nameAr                   String?
  nameEn                   String?
  addressAr                String?
  addressEn                String?
  poBox                    String?
  phone                    String?
  mobile                   String?
  whatsapp                 String?
  logoUrl                  String?
  letterheadUrl            String?
  signatureUrl             String?
  stampUrl                 String?
  slug                     String                          @unique
  defaultLocale            Locale                          @default(EN)
  brandTheme               CompanyBrandTheme               @default(NAVY_GOLD)
  defaultCurrency          String                          @default("KWD")
  timezone                 String                          @default("Asia/Kuwait")
  isActive                 Boolean                         @default(true)
  members                  CompanyMember[]
  customers                Customer[]
  customerSequence         CustomerSequence?
  units                    Unit[]
  catalogItems             CatalogItem[]
  catalogItemLocalizations CatalogItemLocalization[]
  catalogCategories        CatalogCategory[]
  taxRates                 TaxRate[]
  priceLists               PriceList[]
  quotations               Quotation[]
  salesOrders              SalesOrder[]
  salesOrderActivities     SalesOrderActivity[]
  quotationDeliveries      QuotationDelivery[]
  quotationTermsTemplates  CompanyQuotationTermsTemplate[]
  contracts                Contract[]
  contractNumberSequences  ContractNumberSequence[]
  invoices                 Invoice[]
  invoiceNumberSequences   InvoiceNumberSequence[]
  payments                 Payment[]
  invoiceEvents            InvoiceEvent[]
  authorizedSignatories    AuthorizedSignatory[]
  drawingTakeoffSessions   DrawingTakeoffSession[]
  sourceArtifacts          SourceArtifact[]
  citations                Citation[]
  artifactDerivations      ArtifactDerivation[]
  crossDocumentClaims      NormalizedEvidenceClaim[]
  crossDocumentMaterializations CrossDocumentMaterialization[]
  comparisonScopes         ComparisonScope[]
  comparisonScopeArtifacts ComparisonScopeArtifact[]
  comparisonRuns           ComparisonRun[]
  subjectMatches           SubjectMatch[]
  subjectClusters          SubjectCluster[]
  crossDocumentFindings    CrossDocumentFinding[]
  findingReviewEvents      FindingReviewEvent[]
  documentIdentities       DocumentIdentity[]
  documentRevisionMemberships DocumentRevisionMembership[]
  documentRelations        DocumentRelation[]
  activeRevisionDecisions  ActiveRevisionDecision[]
  findingEvidenceObservations FindingEvidenceObservation[]
  requirements             Requirement[]
  universalAdoptions       UniversalItemAdoption[]
  universalLibrarySectors  CompanyUniversalLibrarySector[]
  localizedContents        LocalizedContent[]
  notifications            Notification[]
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  @@index([name])
  @@index([isActive])
}

enum DrawingTakeoffStatus {
  REVIEW_REQUIRED
  CONFIRMED
  CONVERTED
  CANCELLED
}

enum TakeoffQuantityProvenance {
  DRAWING_COUNTED
  DRAWING_MEASURED
  CALCULATED
  USER_PROVIDED
  AI_INTERPRETED
  CATALOG_MAPPED
  NEEDS_CONFIRMATION
}

model DrawingTakeoffSession {
  id              String               @id @default(cuid())
  companyId       String
  createdByUserId String
  sourceFileName  String
  sourceMimeType  String
  sourceSizeBytes Int
  sourceSha256    String
  userIntent      String
  discipline      String               @default("CCTV_LOW_VOLTAGE")
  status          DrawingTakeoffStatus @default(REVIEW_REQUIRED)
  confirmedAt     DateTime?
  convertedAt     DateTime?
  quotationId     String?
  sourceArtifactId String?
  version         Int                  @default(1)
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceArtifact  SourceArtifact?     @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  lines           DrawingTakeoffLine[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([companyId, sourceSha256, userIntent])
  @@index([companyId, status, createdAt])
  @@index([companyId, quotationId])
  @@index([companyId, sourceArtifactId])
}

model DrawingTakeoffLine {
  id            String                    @id @default(cuid())
  sessionId     String
  position      Int
  itemName      String
  description   String?
  quantity      Decimal?                  @db.Decimal(18, 3)
  unitName      String?
  provenance    TakeoffQuantityProvenance
  evidence      String?
  confidence    Decimal?                  @db.Decimal(5, 4)
  isConfirmed   Boolean                   @default(false)
  confirmedById String?
  confirmedAt   DateTime?
  session       DrawingTakeoffSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([sessionId, position])
  @@index([sessionId, isConfirmed])
}

model SourceArtifact {
  id                       String                       @id @default(cuid())
  companyId                String
  originalFilename         String
  mimeType                 String
  sizeBytes                Int
  contentSha256            String
  kind                     SourceArtifactKind
  storageRef               String
  context                  SourceArtifactContext
  conversationRuntimeId    String?
  processingState          SourceArtifactProcessingState @default(RECEIVED)
  extractedText            String?
  extractedPages           Json?
  processingError          String?
  createdByUserId          String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  company                  Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy                User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  citations                Citation[]
  takeoffSessions          DrawingTakeoffSession[]
  /// Phase 2A-9: derivations in which this artifact is the proprietary ORIGINAL.
  derivationsAsOriginal    ArtifactDerivation[]         @relation("DerivationOriginal")
  /// Phase 2A-9: derivations in which this artifact is the DERIVED result.
  derivationsAsDerived     ArtifactDerivation[]         @relation("DerivationDerived")
  /// Phase 2A-10 evidence records that cite this artifact as their source.
  claimSourceArtifacts     NormalizedEvidenceClaim[]    @relation("ClaimSourceArtifact")
  materializationRecords   CrossDocumentMaterialization[] @relation("MaterializationSourceArtifact")
  scopeMemberships         ComparisonScopeArtifact[]    @relation("ScopeArtifact")
  findingParticipantEntries FindingParticipant[]        @relation("ParticipantSourceArtifact")
  documentIdentityEvidence DocumentIdentityEvidence[]   @relation("IdentityEvidenceArtifact")
  revisionMembershipRecords DocumentRevisionMembership[] @relation("MembershipSourceArtifact")

  @@unique([companyId, contentSha256, originalFilename])
  @@index([companyId, context, createdAt])
  @@index([companyId, processingState])
}

/// Phase 2A-9: explicit, immutable lineage between a proprietary ORIGINAL
/// artifact (DWG / RVT) and a separately stored DERIVED artifact (DXF / IFC).
///
/// The original row is never mutated into the derived format: both artifacts
/// stay independently addressable forever, and this relation is the only link.
/// Every automated conversion is idempotent through `derivationKey`
/// (source hash + kind + method + converter id/version + canonical options);
/// every user-provided export is idempotent through the source/derived hash
/// pair. Historical derivations are never overwritten.
model ArtifactDerivation {
  id                  String                  @id @default(cuid())
  companyId           String
  originalArtifactId  String
  derivedArtifactId   String?
  derivationKind      ArtifactDerivationKind
  derivationMethod    ArtifactDerivationMethod
  /// Converter identity for AUTOMATED_CONVERSION; always null for
  /// USER_PROVIDED_EXPORT (VOKA never fabricates a converter for a user export).
  converterId         String?
  converterVersion    String?
  /// Deterministic canonical fingerprint of the conversion options.
  optionsFingerprint  String
  sourceFormat        String
  derivedFormat       String
  sourceHash          String
  derivedHash         String?
  status              ArtifactDerivationStatus @default(PENDING)
  failureReason       String?
  /// Channel A: converter/provider warnings. Never merged with VOKA limitations.
  warnings            String[]                @default([])
  /// Channel B: static VOKA-authored fidelity limitations. Never merged with
  /// provider warnings.
  fidelityLimitations String[]                @default([])
  /// Deterministic idempotency key, unique per company.
  derivationKey       String
  createdAt           DateTime                @default(now())
  completedAt         DateTime?
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originalArtifact    SourceArtifact          @relation("DerivationOriginal", fields: [originalArtifactId], references: [id], onDelete: Cascade)
  derivedArtifact     SourceArtifact?         @relation("DerivationDerived", fields: [derivedArtifactId], references: [id], onDelete: SetNull)

  @@unique([companyId, derivationKey])
  @@index([companyId, originalArtifactId])
  @@index([companyId, derivedArtifactId])
  @@index([companyId, status, createdAt])
}

model Citation {
  id                    String    @id @default(cuid())
  companyId             String
  sourceArtifactId      String?
  sourceType            String
  title                 String
  pageNumber            Int?
  sheet                 String?
  section               String?
  lineLocator           String?
  url                   String?
  publisher             String?
  observedAt            DateTime  @default(now())
  provenance            String
  verificationState     String
  confidence            Decimal?  @db.Decimal(5, 4)
  supportedClaimSummary String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceArtifact        SourceArtifact? @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  requirementLinks      RequirementCitation[]

  @@index([companyId, sourceArtifactId])
  @@index([companyId, sourceType])
}

model Requirement {
  id                    String                    @id @default(cuid())
  companyId             String
  stableKey             String
  revision              Int                       @default(1)
  sourceContext         SourceArtifactContext
  parentId              String?
  systemKey             String?
  componentKey          String?
  materialKey           String?
  serviceKey            String?
  description           String
  quantity              Decimal?                  @db.Decimal(18, 3)
  unit                  String?
  technicalRequirement  String?
  quantityStatus        RequirementQuantityStatus @default(UNKNOWN)
  reviewState           RequirementReviewState    @default(NEEDS_REVIEW)
  locality              String?
  provenance             String
  correctionTrace       Json?
  createdByUserId       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy             User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  parent                Requirement?              @relation("RequirementHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Requirement[]              @relation("RequirementHierarchy")
  citations             RequirementCitation[]

  @@unique([companyId, stableKey])
  @@index([companyId, sourceContext, reviewState])
  @@index([companyId, systemKey, componentKey])
}

model RequirementCitation {
  requirementId String
  citationId    String
  claimSummary  String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  citation      Citation   @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([requirementId, citationId])
  @@index([citationId])
}

model AuthorizedSignatory {
  id                   String   @id @default(cuid())
  companyId            String
  nameAr               String?
  nameEn               String?
  titleAr              String?
  titleEn              String?
  signatureUrl         String?
  isActive             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  allowedDocumentTypes String[] @default([])
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, isDefault])
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  passwordHash         String?
  locale               Locale                  @default(EN)
  isActive             Boolean                 @default(true)
  memberships          CompanyMember[]
  createdSalesOrders   SalesOrder[]            @relation("SalesOrderCreatedBy")
  confirmedSalesOrders SalesOrder[]            @relation("SalesOrderConfirmedBy")
  cancelledSalesOrders SalesOrder[]            @relation("SalesOrderCancelledBy")
  salesOrderActivities SalesOrderActivity[]
  createdContracts     Contract[]              @relation("ContractCreatedBy")
  createdInvoices      Invoice[]               @relation("InvoiceCreatedBy")
  issuedInvoices       Invoice[]               @relation("InvoiceIssuedBy")
  voidedInvoices       Invoice[]               @relation("InvoiceVoidedBy")
  recordedPayments     Payment[]               @relation("PaymentRecordedBy")
  invoiceEvents        InvoiceEvent[]
  universalAdoptions   UniversalItemAdoption[]
  quotationDeliveries  QuotationDelivery[]
  createdSourceArtifacts SourceArtifact[]
  createdRequirements  Requirement[]
  notifications        Notification[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([isActive])
}

model CompanyMember {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole      @default(SALES)
  status    MembershipStatus @default(ACTIVE)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model Customer {
  id                String         @id @default(cuid())
  companyId         String
  code              String
  type              CustomerType   @default(COMPANY)
  status            CustomerStatus @default(LEAD)
  name              String
  nameAr            String?
  nameEn            String?
  legalName         String?
  email             String?
  phone             String?
  mobile            String?
  whatsapp          String?
  taxNumber         String?
  addressLine1      String?
  addressLine1Ar    String?
  addressLine1En    String?
  addressLine2      String?
  addressLine2Ar    String?
  addressLine2En    String?
  city              String?
  cityAr            String?
  cityEn            String?
  state             String?
  stateAr           String?
  stateEn           String?
  postalCode        String?
  countryCode       String?
  preferredLocale   Locale?
  preferredCurrency String?
  creditLimit       Decimal?       @db.Decimal(18, 3)
  paymentTermDays   Int?
  notes             String?
  notesAr           String?
  notesEn           String?
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  contracts         Contract[]
  invoices          Invoice[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, nameAr])
  @@index([companyId, nameEn])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, isDeleted])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, taxNumber])
}

model CustomerSequence {
  companyId String  @id
  nextValue Int     @default(1)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ContractStatus {
  DRAFT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum InvoiceSettlementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum CommercialDocumentOrigin {
  DIRECT
  QUOTATION
  SALES_ORDER
  CONTRACT
}

enum MilestoneAmountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LocalizedContentStatus {
  PENDING
  VALID
  STALE
  FAILED
}

enum LocalizationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum QuotationDeliveryChannel {
  EMAIL
  WHATSAPP
}

enum QuotationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum QuotationScopeType {
  SUPPLY_ONLY
  SUPPLY_AND_INSTALLATION
  INSTALLATION_ONLY
  SERVICE
  MAINTENANCE
  CONSULTATION
  CUSTOM
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  SHIPPING
  LABOR
  DISCOUNT
  CUSTOM
}

enum UniversalItemType {
  PRODUCT
  SERVICE
  SYSTEM
  SOLUTION
  SHIPPING
  LABOR
  DISCOUNT
  CUSTOM
}

model CatalogCategory {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Unit {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  nameAr    String?
  nameEn    String?
  symbol    String
  isActive  Boolean @default(true)

  company Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, symbol])
  @@index([companyId])
  @@index([name])
  @@index([isActive])
}

model TaxRate {
  id         String  @id @default(cuid())
  companyId  String?
  name       String
  percentage Decimal @db.Decimal(5, 2)
  isSystem   Boolean @default(false)
  isActive   Boolean @default(true)

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           CatalogItem[]
  quotationLines  QuotationLine[]
  salesOrderLines SalesOrderLine[]
  contractLines   ContractLine[]
  invoiceLines    InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isSystem])
  @@index([isActive])
}

model CatalogItem {
  id String @id @default(cuid())

  companyId String

  categoryId String?

  unitId String?

  taxRateId String?

  type CatalogItemType

  code    String
  sku     String?
  barcode String?

  name          String
  nameAr        String?
  nameEn        String?
  description   String?
  descriptionAr String?
  descriptionEn String?

  purchasePrice Decimal? @db.Decimal(18, 3)
  salePrice     Decimal? @db.Decimal(18, 3)

  trackInventory Boolean @default(true)
  allowDiscount  Boolean @default(true)

  imageUrl String?
  notes    String?

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category CatalogCategory? @relation(fields: [categoryId], references: [id])

  unit Unit? @relation(fields: [unitId], references: [id])

  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  priceListItems    PriceListItem[]
  localizations     CatalogItemLocalization[]
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]
  contractLines     ContractLine[]
  invoiceLines      InvoiceLine[]
  universalAdoption UniversalItemAdoption?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([barcode])
}

enum CatalogLocalizationSource {
  HUMAN
  GOVERNED
  LEGACY
}

model CatalogItemLocalization {
  id            String                    @id @default(cuid())
  companyId     String
  catalogItemId String
  locale        String
  name          String
  description   String?
  source        CatalogLocalizationSource @default(HUMAN)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([catalogItemId, locale])
  @@index([companyId, locale, name])
  @@index([companyId, catalogItemId])
}

model PriceList {
  id           String  @id @default(cuid())
  companyId    String
  code         String
  name         String
  currencyCode String  @default("KWD")
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       PriceListItem[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  contracts   Contract[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, isDefault])
  @@index([companyId, isActive])
}

model PriceListItem {
  id            String  @id @default(cuid())
  priceListId   String
  catalogItemId String
  price         Decimal @db.Decimal(18, 3)

  priceList   PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priceListId, catalogItemId])
  @@index([priceListId])
  @@index([catalogItemId])
}

model CompanyQuotationTermsTemplate {
  id        String @id @default(cuid())
  companyId String

  scopeType QuotationScopeType

  termsAr String?
  termsEn String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, scopeType])
  @@index([companyId])
  @@index([companyId, scopeType])
}

model Quotation {
  id String @id @default(cuid())

  companyId   String
  customerId  String?
  priceListId String?

  number             String
  familyId           String
  revisionNumber     Int             @default(0)
  previousRevisionId String?         @unique
  isCurrentRevision  Boolean         @default(true)
  supersededAt       DateTime?
  status             QuotationStatus @default(DRAFT)
  issueDate          DateTime        @default(now())
  expiryDate         DateTime?
  currencyCode       String          @default("KWD")
  customerName       String?
  customerNameAr     String?
  customerNameEn     String?
  customerEmail      String?
  customerPhone      String?
  customerTaxNo      String?
  billingAddress     String?

