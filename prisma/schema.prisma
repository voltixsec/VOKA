enum DrawingTakeoffStatus {
  REVIEW_REQUIRED
  CONFIRMED
  CONVERTED
  CANCELLED
}

enum TakeoffQuantityProvenance {
  DRAWING_COUNTED
  DRAWING_MEASURED
  CALCULATED
  USER_PROVIDED
  AI_INTERPRETED
  CATALOG_MAPPED
  NEEDS_CONFIRMATION
}

model DrawingTakeoffSession {
  id              String               @id @default(cuid())
  companyId       String
  createdByUserId String
  sourceFileName  String
  sourceMimeType  String
  sourceSizeBytes Int
  sourceSha256    String
  userIntent      String
  discipline      String               @default("CCTV_LOW_VOLTAGE")
  status          DrawingTakeoffStatus @default(REVIEW_REQUIRED)
  confirmedAt     DateTime?
  convertedAt     DateTime?
  quotationId     String?
  sourceArtifactId String?
  version         Int                  @default(1)
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceArtifact  SourceArtifact?     @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  lines           DrawingTakeoffLine[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([companyId, sourceSha256, userIntent])
  @@index([companyId, status, createdAt])
  @@index([companyId, quotationId])
  @@index([companyId, sourceArtifactId])
}

model DrawingTakeoffLine {
  id            String                    @id @default(cuid())
  sessionId     String
  position      Int
  itemName      String
  description   String?
  quantity      Decimal?                  @db.Decimal(18, 3)
  unitName      String?
  provenance    TakeoffQuantityProvenance
  evidence      String?
  confidence    Decimal?                  @db.Decimal(5, 4)
  isConfirmed   Boolean                   @default(false)
  confirmedById String?
  confirmedAt   DateTime?
  session       DrawingTakeoffSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([sessionId, position])
  @@index([sessionId, isConfirmed])
}

model SourceArtifact {
  id                       String                       @id @default(cuid())
  companyId                String
  originalFilename         String
  mimeType                 String
  sizeBytes                Int
  contentSha256            String
  kind                     SourceArtifactKind
  storageRef               String
  context                  SourceArtifactContext
  conversationRuntimeId    String?
  processingState          SourceArtifactProcessingState @default(RECEIVED)
  extractedText            String?
  extractedPages           Json?
  processingError          String?
  createdByUserId          String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  company                  Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy                User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  citations                Citation[]
  takeoffSessions          DrawingTakeoffSession[]
  /// Phase 2A-9: derivations in which this artifact is the proprietary ORIGINAL.
  derivationsAsOriginal    ArtifactDerivation[]         @relation("DerivationOriginal")
  /// Phase 2A-9: derivations in which this artifact is the DERIVED result.
  derivationsAsDerived     ArtifactDerivation[]         @relation("DerivationDerived")
  /// Phase 2A-10 evidence records that cite this artifact as their source.
  claimSourceArtifacts     NormalizedEvidenceClaim[]    @relation("ClaimSourceArtifact")
  materializationRecords   CrossDocumentMaterialization[] @relation("MaterializationSourceArtifact")
  scopeMemberships         ComparisonScopeArtifact[]    @relation("ScopeArtifact")
  findingParticipantEntries FindingParticipant[]        @relation("ParticipantSourceArtifact")
  documentIdentityEvidence DocumentIdentityEvidence[]   @relation("IdentityEvidenceArtifact")
  revisionMembershipRecords DocumentRevisionMembership[] @relation("MembershipSourceArtifact")

  @@unique([companyId, contentSha256, originalFilename])
  @@index([companyId, context, createdAt])
  @@index([companyId, processingState])
}

/// Phase 2A-9: explicit, immutable lineage between a proprietary ORIGINAL
/// artifact (DWG / RVT) and a separately stored DERIVED artifact (DXF / IFC).
///
/// The original row is never mutated into the derived format: both artifacts
/// stay independently addressable forever, and this relation is the only link.
/// Every automated conversion is idempotent through `derivationKey`
/// (source hash + kind + method + converter id/version + canonical options);
/// every user-provided export is idempotent through the source/derived hash
/// pair. Historical derivations are never overwritten.
model ArtifactDerivation {
  id                  String                  @id @default(cuid())
  companyId           String
  originalArtifactId  String
  derivedArtifactId   String?
  derivationKind      ArtifactDerivationKind
  derivationMethod    ArtifactDerivationMethod
  /// Converter identity for AUTOMATED_CONVERSION; always null for
  /// USER_PROVIDED_EXPORT (VOKA never fabricates a converter for a user export).
  converterId         String?
  converterVersion    String?
  /// Deterministic canonical fingerprint of the conversion options.
  optionsFingerprint  String
  sourceFormat        String
  derivedFormat       String
  sourceHash          String
  derivedHash         String?
  status              ArtifactDerivationStatus @default(PENDING)
  failureReason       String?
  /// Channel A: converter/provider warnings. Never merged with VOKA limitations.
  warnings            String[]                @default([])
  /// Channel B: static VOKA-authored fidelity limitations. Never merged with
  /// provider warnings.
  fidelityLimitations String[]                @default([])
  /// Deterministic idempotency key, unique per company.
  derivationKey       String
  createdAt           DateTime                @default(now())
  completedAt         DateTime?
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originalArtifact    SourceArtifact          @relation("DerivationOriginal", fields: [originalArtifactId], references: [id], onDelete: Cascade)
  derivedArtifact     SourceArtifact?         @relation("DerivationDerived", fields: [derivedArtifactId], references: [id], onDelete: SetNull)

  @@unique([companyId, derivationKey])
  @@index([companyId, originalArtifactId])
  @@index([companyId, derivedArtifactId])
  @@index([companyId, status, createdAt])
}

model Citation {
  id                    String    @id @default(cuid())
  companyId             String
  sourceArtifactId      String?
  sourceType            String
  title                 String
  pageNumber            Int?
  sheet                 String?
  section               String?
  lineLocator           String?
  url                   String?
  publisher             String?
  observedAt            DateTime  @default(now())
  provenance            String
  verificationState     String
  confidence            Decimal?  @db.Decimal(5, 4)
  supportedClaimSummary String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceArtifact        SourceArtifact? @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  requirementLinks      RequirementCitation[]

  @@index([companyId, sourceArtifactId])
  @@index([companyId, sourceType])
}

model Requirement {
  id                    String                    @id @default(cuid())
  companyId             String
  stableKey             String
  revision              Int                       @default(1)
  sourceContext         SourceArtifactContext
  parentId              String?
  systemKey             String?
  componentKey          String?
  materialKey           String?
  serviceKey            String?
  description           String
  quantity              Decimal?                  @db.Decimal(18, 3)
  unit                  String?
  technicalRequirement  String?
  quantityStatus        RequirementQuantityStatus @default(UNKNOWN)
  reviewState           RequirementReviewState    @default(NEEDS_REVIEW)
  locality              String?
  provenance             String
  correctionTrace       Json?
  createdByUserId       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy             User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  parent                Requirement?              @relation("RequirementHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Requirement[]              @relation("RequirementHierarchy")
  citations             RequirementCitation[]

  @@unique([companyId, stableKey])
  @@index([companyId, sourceContext, reviewState])
  @@index([companyId, systemKey, componentKey])
}

model RequirementCitation {
  requirementId String
  citationId    String
  claimSummary  String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  citation      Citation   @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@id([requirementId, citationId])
  @@index([citationId])
}

model AuthorizedSignatory {
  id                   String   @id @default(cuid())
  companyId            String
  nameAr               String?
  nameEn               String?
  titleAr              String?
  titleEn              String?
  signatureUrl         String?
  isActive             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  allowedDocumentTypes String[] @default([])
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, isDefault])
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  passwordHash         String?
  locale               Locale                  @default(EN)
  isActive             Boolean                 @default(true)
  memberships          CompanyMember[]
  createdSalesOrders   SalesOrder[]            @relation("SalesOrderCreatedBy")
  confirmedSalesOrders SalesOrder[]            @relation("SalesOrderConfirmedBy")
  cancelledSalesOrders SalesOrder[]            @relation("SalesOrderCancelledBy")
  salesOrderActivities SalesOrderActivity[]
  createdContracts     Contract[]              @relation("ContractCreatedBy")
  createdInvoices      Invoice[]               @relation("InvoiceCreatedBy")
  issuedInvoices       Invoice[]               @relation("InvoiceIssuedBy")
  voidedInvoices       Invoice[]               @relation("InvoiceVoidedBy")
  recordedPayments     Payment[]               @relation("PaymentRecordedBy")
  invoiceEvents        InvoiceEvent[]
  universalAdoptions   UniversalItemAdoption[]
  quotationDeliveries  QuotationDelivery[]
  createdSourceArtifacts SourceArtifact[]
  createdRequirements  Requirement[]
  notifications        Notification[]
  engineeringQuantityDecisions EngineeringQuantityDecision[] @relation("EngineeringDecisionActor")
  engineeringAdjustmentApprovals EngineeringAdjustment[] @relation("EngineeringAdjustmentApprover")
  engineeringBomVersions EngineeringBomVersion[] @relation("EngineeringBomActor")
  engineeringBomApprovals EngineeringBomVersion[] @relation("EngineeringBomApprover")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([isActive])
}

model CompanyMember {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole      @default(SALES)
  status    MembershipStatus @default(ACTIVE)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model Customer {
  id                String         @id @default(cuid())
  companyId         String
  code              String
  type              CustomerType   @default(COMPANY)
  status            CustomerStatus @default(LEAD)
  name              String
  nameAr            String?
  nameEn            String?
  legalName         String?
  email             String?
  phone             String?
  mobile            String?
  whatsapp          String?
  taxNumber         String?
  addressLine1      String?
  addressLine1Ar    String?
  addressLine1En    String?
  addressLine2      String?
  addressLine2Ar    String?
  addressLine2En    String?
  city              String?
  cityAr            String?
  cityEn            String?
  state             String?
  stateAr           String?
  stateEn           String?
  postalCode        String?
  countryCode       String?
  preferredLocale   Locale?
  preferredCurrency String?
  creditLimit       Decimal?       @db.Decimal(18, 3)
  paymentTermDays   Int?
  notes             String?
  notesAr           String?
  notesEn           String?
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  contracts         Contract[]
  invoices          Invoice[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, nameAr])
  @@index([companyId, nameEn])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, isDeleted])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, taxNumber])
}

model CustomerSequence {
  companyId String  @id
  nextValue Int     @default(1)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

