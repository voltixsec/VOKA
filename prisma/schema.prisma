generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyBrandTheme {
  NAVY_GOLD
  ROYAL_BLUE
  EMERALD
  BURGUNDY
  CHARCOAL
}

enum Locale {
  EN
  AR
}

enum CompanyRole {
  OWNER
  ADMIN
  SALES
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id                      String                          @id @default(cuid())
  name                    String
  nameAr                  String?
  nameEn                  String?
  addressAr               String?
  addressEn               String?
  poBox                   String?
  phone                   String?
  mobile                  String?
  whatsapp                String?
  logoUrl                 String?
  letterheadUrl           String?
  signatureUrl            String?
  stampUrl                String?
  slug                    String                          @unique
  defaultLocale           Locale                          @default(EN)
  brandTheme              CompanyBrandTheme               @default(NAVY_GOLD)
  defaultCurrency         String                          @default("KWD")
  timezone                String                          @default("Asia/Kuwait")
  isActive                Boolean                         @default(true)
  members                 CompanyMember[]
  customers               Customer[]
  customerSequence        CustomerSequence?
  units                   Unit[]
  catalogItems            CatalogItem[]
  catalogCategories       CatalogCategory[]
  taxRates                TaxRate[]
  priceLists              PriceList[]
  quotations              Quotation[]
  salesOrders             SalesOrder[]
  salesOrderActivities    SalesOrderActivity[]
  quotationDeliveries     QuotationDelivery[]
  quotationTermsTemplates CompanyQuotationTermsTemplate[]
  contracts               Contract[]
  contractNumberSequences ContractNumberSequence[]
  universalAdoptions      UniversalItemAdoption[]
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@index([name])
  @@index([isActive])
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  passwordHash         String?
  locale               Locale                  @default(EN)
  isActive             Boolean                 @default(true)
  memberships          CompanyMember[]
  createdSalesOrders   SalesOrder[]            @relation("SalesOrderCreatedBy")
  confirmedSalesOrders SalesOrder[]            @relation("SalesOrderConfirmedBy")
  cancelledSalesOrders SalesOrder[]            @relation("SalesOrderCancelledBy")
  salesOrderActivities SalesOrderActivity[]
  createdContracts     Contract[]              @relation("ContractCreatedBy")
  universalAdoptions   UniversalItemAdoption[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([isActive])
}

model CompanyMember {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole      @default(SALES)
  status    MembershipStatus @default(ACTIVE)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model Customer {
  id                String         @id @default(cuid())
  companyId         String
  code              String
  type              CustomerType   @default(COMPANY)
  status            CustomerStatus @default(LEAD)
  name              String
  nameAr            String?
  nameEn            String?
  legalName         String?
  email             String?
  phone             String?
  mobile            String?
  whatsapp          String?
  taxNumber         String?
  addressLine1      String?
  addressLine1Ar    String?
  addressLine1En    String?
  addressLine2      String?
  addressLine2Ar    String?
  addressLine2En    String?
  city              String?
  cityAr            String?
  cityEn            String?
  state             String?
  stateAr           String?
  stateEn           String?
  postalCode        String?
  countryCode       String?
  preferredLocale   Locale?
  preferredCurrency String?
  creditLimit       Decimal?       @db.Decimal(18, 3)
  paymentTermDays   Int?
  notes             String?
  notesAr           String?
  notesEn           String?
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  contracts         Contract[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, nameAr])
  @@index([companyId, nameEn])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, isDeleted])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, taxNumber])
}

model CustomerSequence {
  companyId String  @id
  nextValue Int     @default(1)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ContractStatus {
  DRAFT
}

enum CommercialDocumentOrigin {
  DIRECT
  QUOTATION
  SALES_ORDER
  CONTRACT
}

enum MilestoneAmountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LocalizationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum QuotationDeliveryChannel {
  EMAIL
  WHATSAPP
}

enum QuotationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum QuotationScopeType {
  SUPPLY_ONLY
  SUPPLY_AND_INSTALLATION
  INSTALLATION_ONLY
  SERVICE
  MAINTENANCE
  CONSULTATION
  CUSTOM
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  SHIPPING
  LABOR
  DISCOUNT
  CUSTOM
}

model CatalogCategory {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Unit {
  id        String  @id @default(cuid())
  companyId String?
  name      String
  nameAr    String?
  nameEn    String?
  symbol    String
  isActive  Boolean @default(true)

  company Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, symbol])
  @@index([companyId])
  @@index([name])
  @@index([isActive])
}

model TaxRate {
  id         String  @id @default(cuid())
  companyId  String?
  name       String
  percentage Decimal @db.Decimal(5, 2)
  isSystem   Boolean @default(false)
  isActive   Boolean @default(true)

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           CatalogItem[]
  quotationLines  QuotationLine[]
  salesOrderLines SalesOrderLine[]
  contractLines   ContractLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isSystem])
  @@index([isActive])
}

model CatalogItem {
  id String @id @default(cuid())

  companyId String

  categoryId String?

  unitId String?

  taxRateId String?

  type CatalogItemType

  code    String
  sku     String?
  barcode String?

  name          String
  nameAr        String?
  nameEn        String?
  description   String?
  descriptionAr String?
  descriptionEn String?

  purchasePrice Decimal? @db.Decimal(18, 3)
  salePrice     Decimal  @db.Decimal(18, 3)

  trackInventory Boolean @default(true)
  allowDiscount  Boolean @default(true)

  imageUrl String?
  notes    String?

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category CatalogCategory? @relation(fields: [categoryId], references: [id])

  unit Unit? @relation(fields: [unitId], references: [id])

  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  priceListItems    PriceListItem[]
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]
  contractLines     ContractLine[]
  universalAdoption UniversalItemAdoption?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([barcode])
}

model PriceList {
  id           String  @id @default(cuid())
  companyId    String
  code         String
  name         String
  currencyCode String  @default("KWD")
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       PriceListItem[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  contracts   Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, isDefault])
  @@index([companyId, isActive])
}

model PriceListItem {
  id            String  @id @default(cuid())
  priceListId   String
  catalogItemId String
  price         Decimal @db.Decimal(18, 3)

  priceList   PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priceListId, catalogItemId])
  @@index([priceListId])
  @@index([catalogItemId])
}

model CompanyQuotationTermsTemplate {
  id        String @id @default(cuid())
  companyId String

  scopeType QuotationScopeType

  termsAr String?
  termsEn String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, scopeType])
  @@index([companyId])
  @@index([companyId, scopeType])
}

model Quotation {
  id String @id @default(cuid())

  companyId   String
  customerId  String
  priceListId String?

  number         String
  status         QuotationStatus @default(DRAFT)
  issueDate      DateTime        @default(now())
  expiryDate     DateTime?
  currencyCode   String          @default("KWD")
  customerName   String
  customerNameAr String?
  customerNameEn String?
  customerEmail  String?
  customerPhone  String?
  customerTaxNo  String?
  billingAddress String?

  subjectAr       String?
  subjectEn       String?
  briefAr         String?
  briefEn         String?
  projectName     String?
  attentionName   String?
  projectNameAr   String?
  projectNameEn   String?
  attentionNameAr String?
  attentionNameEn String?
  scopeType       QuotationScopeType?

  subtotal       Decimal       @default(0) @db.Decimal(18, 3)
  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(18, 3)
  discountAmount Decimal       @default(0) @db.Decimal(18, 3)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 3)
  totalAmount    Decimal       @default(0) @db.Decimal(18, 3)

  notes                String?
  termsAndConditions   String?
  notesAr              String?
  notesEn              String?
  termsAndConditionsAr String?
  termsAndConditionsEn String?

  localizationStatus          LocalizationStatus?
  localizationRequestedAt     DateTime?
  localizationCompletedAt     DateTime?
  localizationLastError       String?
  localizationSourceLocale    Locale?
  localizationSourceSignature String?
  localizationClaimToken      String?
  localizationLeaseUntil      DateTime?
  localizationAttemptCount    Int                 @default(0)

  sentAt                DateTime?
  approvedAt            DateTime?
  approvedByName        String?
  approvedByRole        String?
  documentBrandSnapshot Json?
  verificationToken     String?   @unique
  rejectedAt            DateTime?
  cancelledAt           DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer            @relation(fields: [customerId], references: [id])
  priceList  PriceList?          @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  lines      QuotationLine[]
  deliveries QuotationDelivery[]
  salesOrder SalesOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, issueDate])
  @@index([companyId, expiryDate])
  @@index([companyId, isDeleted])
  @@index([companyId, localizationStatus, localizationLeaseUntil])
  @@index([customerId])
  @@index([priceListId])
}

model QuotationDelivery {
  id String @id @default(cuid())

  companyId   String
  quotationId String

  channel   QuotationDeliveryChannel
  recipient String
  status    QuotationDeliveryStatus  @default(PENDING)

  providerMessageId String?
  errorCode         String?
  errorMessage      String?

  attemptedAt DateTime
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([companyId, quotationId])
  @@index([quotationId, createdAt])
  @@index([companyId, status])
}

model QuotationLine {
  id String @id @default(cuid())

  quotationId   String
  catalogItemId String?
  taxRateId     String?

  position Int
  type     CatalogItemType

  itemCode      String?
  itemName      String
  description   String?
  itemNameAr    String?
  itemNameEn    String?
  descriptionAr String?
  descriptionEn String?
  unitName      String?
  unitNameAr    String?
  unitNameEn    String?

  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 3)

  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(18, 3)
  discountAmount Decimal       @default(0) @db.Decimal(18, 3)

  taxPercentage Decimal @default(0) @db.Decimal(5, 2)
  taxAmount     Decimal @default(0) @db.Decimal(18, 3)

  subtotal    Decimal @db.Decimal(18, 3)
  totalAmount Decimal @db.Decimal(18, 3)

  quotation      Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  catalogItem    CatalogItem?    @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  salesOrderLine SalesOrderLine?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, position])
  @@index([quotationId])
  @@index([catalogItemId])
  @@index([taxRateId])
  @@index([quotationId, type])
}

model SalesOrder {
  id String @id @default(cuid())

  companyId             String
  sourceQuotationId     String           @unique
  sourceQuotationNumber String
  number                String
  status                SalesOrderStatus @default(DRAFT)
  customerId            String
  priceListId           String?
  currencyCode          String
  orderDate             DateTime         @default(now())

  customerName   String
  customerNameAr String?
  customerNameEn String?
  customerEmail  String?
  customerPhone  String?
  customerTaxNo  String?
  billingAddress String?

  subjectAr       String?
  subjectEn       String?
  briefAr         String?
  briefEn         String?
  projectName     String?
  projectNameAr   String?
  projectNameEn   String?
  attentionName   String?
  attentionNameAr String?
  attentionNameEn String?
  scopeType       QuotationScopeType?

  subtotal       Decimal       @db.Decimal(18, 3)
  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(18, 3)
  discountAmount Decimal       @default(0) @db.Decimal(18, 3)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 3)
  totalAmount    Decimal       @default(0) @db.Decimal(18, 3)

  notes                String?
  notesAr              String?
  notesEn              String?
  termsAndConditions   String?
  termsAndConditionsAr String?
  termsAndConditionsEn String?

  sourceApprovedAt     DateTime
  sourceApprovedByName String
  sourceApprovedByRole String
  createdByUserId      String?
  createdByName        String
  createdByRole        String

  confirmedAt       DateTime?
  confirmedByUserId String?
  confirmedByName   String?
  confirmedByRole   String?

  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancelledByName    String?
  cancelledByRole    String?
  cancellationReason String?

  documentBrandSnapshot Json?

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceQuotation Quotation            @relation(fields: [sourceQuotationId], references: [id], onDelete: Restrict)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  priceList       PriceList?           @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdByUser   User?                @relation("SalesOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmedByUser User?                @relation("SalesOrderConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?                @relation("SalesOrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  lines           SalesOrderLine[]
  activities      SalesOrderActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, orderDate])
  @@index([customerId])
  @@index([priceListId])
  @@index([createdByUserId])
  @@index([confirmedByUserId])
  @@index([cancelledByUserId])
}

model SalesOrderLine {
  id String @id @default(cuid())

  salesOrderId          String
  sourceQuotationLineId String  @unique
  catalogItemId         String?
  taxRateId             String?

  position Int
  type     CatalogItemType

  itemCode      String?
  itemName      String
  itemNameAr    String?
  itemNameEn    String?
  description   String?
  descriptionAr String?
  descriptionEn String?
  unitName      String?
  unitNameAr    String?
  unitNameEn    String?

  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 3)

  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(18, 3)
  discountAmount Decimal       @default(0) @db.Decimal(18, 3)
  taxPercentage  Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 3)
  subtotal       Decimal       @db.Decimal(18, 3)
  totalAmount    Decimal       @db.Decimal(18, 3)

  salesOrder          SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  sourceQuotationLine QuotationLine @relation(fields: [sourceQuotationLineId], references: [id], onDelete: Restrict)
  catalogItem         CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  taxRate             TaxRate?      @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesOrderId, position])
  @@index([salesOrderId])
  @@index([catalogItemId])
  @@index([taxRateId])
}

model SalesOrderActivity {
  id           String   @id @default(cuid())
  companyId    String
  salesOrderId String
  body         String
  actorUserId  String?
  actorName    String
  actorRole    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  actorUser  User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, salesOrderId, createdAt])
  @@index([salesOrderId])
  @@index([actorUserId])
}

model ContractNumberSequence {
  companyId String
  yearMonth String
  nextValue Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, yearMonth])
}

model Contract {
  id String @id @default(cuid())

  companyId String
  number    String
  status    ContractStatus @default(DRAFT)

  origin     CommercialDocumentOrigin @default(DIRECT)
  sourceKind String?
  sourceId   String?

  customerId   String
  priceListId  String?
  currencyCode String    @default("KWD")
  contractDate DateTime  @default(now())
  startDate    DateTime?
  endDate      DateTime?

  customerName   String
  customerNameAr String?
  customerNameEn String?
  customerEmail  String?
  customerPhone  String?
  customerTaxNo  String?
  billingAddress String?

  subjectAr       String?
  subjectEn       String?
  briefAr         String?
  briefEn         String?
  projectName     String?
  projectNameAr   String?
  projectNameEn   String?
  attentionName   String?
  attentionNameAr String?
  attentionNameEn String?
  scopeType       QuotationScopeType?

  subtotal       Decimal       @db.Decimal(18, 3)
  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(18, 3)
  discountAmount Decimal       @default(0) @db.Decimal(18, 3)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 3)
  totalAmount    Decimal       @db.Decimal(18, 3)

  notes                String?
  notesAr              String?
  notesEn              String?
  termsAndConditions   String?
  termsAndConditionsAr String?
  termsAndConditionsEn String?

  createdByUserId String?
  createdByName   String
  createdByRole   String

  documentBrandSnapshot Json?

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  priceList     PriceList?          @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdByUser User?               @relation("ContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines         ContractLine[]
  milestones    ContractMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, contractDate])
  @@index([customerId])
  @@index([priceListId])
  @@index([createdByUserId])
  @@index([companyId, origin, sourceId])
}

model ContractLine {
  id String @id @default(cuid())

  contractId    String
  sourceLineId  String?
  catalogItemId String?
  taxRateId     String?

  position Int
  type     CatalogItemType

  itemCode      String?
  itemName      String
  itemNameAr    String?
  itemNameEn    String?
  description   String?
  descriptionAr String?
  descriptionEn String?
  unitName      String?
  unitNameAr    String?
  unitNameEn    String?

  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 3)

  discountType   DiscountType?
  discountValue  Decimal       @default(0) @db.Decimal(18, 3)
  discountAmount Decimal       @default(0) @db.Decimal(18, 3)
  taxPercentage  Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 3)
  subtotal       Decimal       @db.Decimal(18, 3)
  totalAmount    Decimal       @db.Decimal(18, 3)

  contract    Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  taxRate     TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, position])
  @@index([contractId])
  @@index([catalogItemId])
  @@index([taxRateId])
}

model ContractMilestone {
  id String @id @default(cuid())

  contractId String
  position   Int

  title         String
  titleAr       String?
  titleEn       String?
  description   String?
  descriptionAr String?
  descriptionEn String?

  amountType  MilestoneAmountType
  percentage  Decimal?            @db.Decimal(5, 2)
  fixedAmount Decimal?            @db.Decimal(18, 3)
  dueDate     DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, position])
  @@index([contractId])
}

enum UniversalVerificationStatus {
  UNVERIFIED
  SOURCE_VERIFIED
  CROSS_VERIFIED
  CURATED
  DEPRECATED
}

enum UniversalIdentifierType {
  GTIN
  GTIN_8
  GTIN_12
  GTIN_13
  GTIN_14
  EAN
  UPC
  MPN
  MODEL_NO
  EXTERNAL_ID
}

enum UniversalAliasType {
  MONIKER
  SEARCH
  SYNONYM
  MPN
  HISTORICAL
  TRANSLITERATION
}

enum UniversalAttributeDataType {
  STRING
  NUMBER
  BOOLEAN
  DECIMAL
  SELECT
  JSON
}

enum UniversalIngestionStatus {
  RECEIVED
  NORMALIZED
  MATCHED
  PROCESSING
  PUBLISHED
  NEEDS_REVIEW
  REJECTED
  FAILED
}

model UniversalCategory {
  id          String   @id @default(cuid())
  parentId    String?
  code        String?
  name        String
  nameAr      String?
  nameEn      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent               UniversalCategory?             @relation("UniversalCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             UniversalCategory[]            @relation("UniversalCategoryHierarchy")
  items                UniversalCatalogItem[]
  attributeDefinitions UniversalAttributeDefinition[]

  @@unique([code])
  @@index([parentId])
  @@index([isActive])
  @@index([name])
}

model UniversalManufacturer {
  id          String   @id @default(cuid())
  code        String?
  name        String
  nameAr      String?
  nameEn      String?
  countryCode String?
  websiteUrl  String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brands      UniversalBrand[]
  items       UniversalCatalogItem[]
  identifiers UniversalItemIdentifier[]

  @@index([code])
  @@index([isActive])
  @@index([name])
}

model UniversalBrand {
  id             String   @id @default(cuid())
  manufacturerId String?
  code           String?
  name           String
  nameAr         String?
  nameEn         String?
  logoUrl        String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer    UniversalManufacturer?   @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  productFamilies UniversalProductFamily[]
  items           UniversalCatalogItem[]

  @@index([manufacturerId])
  @@index([code])
  @@index([isActive])
  @@index([name])
}

model UniversalProductFamily {
  id          String   @id @default(cuid())
  brandId     String?
  code        String?
  name        String
  nameAr      String?
  nameEn      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand UniversalBrand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  items UniversalCatalogItem[]

  @@index([brandId])
  @@index([code])
  @@index([isActive])
  @@index([name])
}

model UniversalSource {
  id                 String                      @id @default(cuid())
  name               String
  type               String
  externalRef        String?
  url                String?
  licenseInfo        String?
  verificationStatus UniversalVerificationStatus @default(UNVERIFIED)
  isActive           Boolean                     @default(true)
  trustScore         Decimal?                    @db.Decimal(3, 2)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  itemProvenances  UniversalItemProvenance[]
  ingestionRecords UniversalIngestionRecord[]

  @@unique([type, externalRef])
  @@index([type])
  @@index([verificationStatus])
  @@index([isActive])
}

model UniversalIngestionRecord {
  id                  String                   @id @default(cuid())
  sourceId            String
  sourceExternalId    String
  entityType          String                   @default("ITEM")
  rawPayload          Json
  payloadHash         String
  status              UniversalIngestionStatus @default(RECEIVED)
  normalizedData      Json?
  matchedItemId       String?
  errorMessage        String?
  retryCount          Int                      @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  source      UniversalSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  matchedItem UniversalCatalogItem? @relation(fields: [matchedItemId], references: [id], onDelete: SetNull)

  @@unique([sourceId, sourceExternalId])
  @@index([sourceId])
  @@index([status, processingStartedAt, createdAt])
  @@index([payloadHash])
  @@index([matchedItemId])
}

model UniversalCatalogItem {
  id            String          @id @default(cuid())
  type          CatalogItemType
  name          String
  nameAr        String?
  nameEn        String?
  searchName    String?
  description   String?
  descriptionAr String?
  descriptionEn String?
  categoryId    String?

  manufacturerId String?
  brandId        String?
  familyId       String?
  modelNumber    String?
  variantName    String?
  parentId       String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category         UniversalCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manufacturer     UniversalManufacturer?        @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  brand            UniversalBrand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  family           UniversalProductFamily?       @relation(fields: [familyId], references: [id], onDelete: SetNull)
  parent           UniversalCatalogItem?         @relation("UniversalCatalogItemVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants         UniversalCatalogItem[]        @relation("UniversalCatalogItemVariants")
  provenances      UniversalItemProvenance[]
  adoptions        UniversalItemAdoption[]
  aliases          UniversalItemAlias[]
  identifiers      UniversalItemIdentifier[]
  attributeValues  UniversalItemAttributeValue[]
  ingestionRecords UniversalIngestionRecord[]

  @@index([type])
  @@index([isActive])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([brandId])
  @@index([familyId])
  @@index([parentId])
  @@index([modelNumber])
  @@index([searchName])
  @@index([name])
  @@index([createdAt])
}

model UniversalItemAlias {
  id              String             @id @default(cuid())
  universalItemId String
  alias           String
  locale          Locale?
  aliasType       UniversalAliasType @default(SYNONYM)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  universalItem UniversalCatalogItem @relation(fields: [universalItemId], references: [id], onDelete: Cascade)

  @@index([universalItemId, alias, locale])
  @@index([universalItemId])
  @@index([alias])
}

model UniversalItemIdentifier {
  id              String                  @id @default(cuid())
  universalItemId String
  identifierType  UniversalIdentifierType
  value           String
  normalizedValue String
  manufacturerId  String?
  source          String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  universalItem UniversalCatalogItem   @relation(fields: [universalItemId], references: [id], onDelete: Cascade)
  manufacturer  UniversalManufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  @@unique([universalItemId, identifierType, normalizedValue])
  @@index([universalItemId])
  @@index([manufacturerId])
  @@index([identifierType, normalizedValue])
  @@index([normalizedValue])
}

model UniversalAttributeDefinition {
  id            String                     @id @default(cuid())
  categoryId    String?
  code          String
  name          String
  nameAr        String?
  nameEn        String?
  dataType      UniversalAttributeDataType @default(STRING)
  unitOfMeasure String?
  description   String?
  isRequired    Boolean                    @default(false)
  isActive      Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  category            UniversalCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  itemAttributeValues UniversalItemAttributeValue[]

  @@index([categoryId])
  @@index([isActive])
  @@index([code])
}

model UniversalItemAttributeValue {
  id                    String   @id @default(cuid())
  universalItemId       String
  attributeDefinitionId String
  valueString           String?
  valueNumber           Decimal? @db.Decimal(18, 4)
  valueBoolean          Boolean?
  valueJson             Json?
  unit                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  universalItem       UniversalCatalogItem         @relation(fields: [universalItemId], references: [id], onDelete: Cascade)
  attributeDefinition UniversalAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([universalItemId, attributeDefinitionId])
  @@index([universalItemId])
  @@index([attributeDefinitionId])
}

model UniversalItemProvenance {
  id              String   @id @default(cuid())
  universalItemId String
  sourceId        String
  externalRef     String?
  confidence      Decimal? @db.Decimal(3, 2)
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  universalItem UniversalCatalogItem @relation(fields: [universalItemId], references: [id], onDelete: Cascade)
  source        UniversalSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([universalItemId, sourceId])
  @@index([universalItemId])
  @@index([sourceId])
}

model UniversalItemAdoption {
  id              String   @id @default(cuid())
  companyId       String
  universalItemId String
  catalogItemId   String   @unique
  adoptedByUserId String?
  adoptedAt       DateTime @default(now())

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  universalItem UniversalCatalogItem @relation(fields: [universalItemId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem          @relation(fields: [companyId, catalogItemId], references: [companyId, id], onDelete: Cascade)
  adoptedByUser User?                @relation(fields: [adoptedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, universalItemId])
  @@unique([companyId, catalogItemId])
  @@index([companyId])
  @@index([universalItemId])
  @@index([adoptedByUserId])
}
