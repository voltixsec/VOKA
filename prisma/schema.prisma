generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  EN
  AR
}

enum CompanyRole {
  OWNER
  ADMIN
  SALES
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  defaultLocale     Locale            @default(EN)
  defaultCurrency   String            @default("KWD")
  timezone          String            @default("Asia/Kuwait")
  isActive          Boolean           @default(true)
  members           CompanyMember[]
  customers         Customer[]
  catalogItems      CatalogItem[]
  catalogCategories CatalogCategory[]
  taxRates          TaxRate[]
  priceLists        PriceList[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([name])
  @@index([isActive])
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String?
  locale       Locale          @default(EN)
  isActive     Boolean         @default(true)
  memberships  CompanyMember[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive])
}

model CompanyMember {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole      @default(SALES)
  status    MembershipStatus @default(ACTIVE)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model Customer {
  id                String         @id @default(cuid())
  companyId         String
  code              String
  type              CustomerType   @default(COMPANY)
  status            CustomerStatus @default(LEAD)
  name              String
  legalName         String?
  email             String?
  phone             String?
  mobile            String?
  taxNumber         String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  countryCode       String?
  preferredLocale   Locale?
  preferredCurrency String?
  creditLimit       Decimal?       @db.Decimal(18, 3)
  paymentTermDays   Int?
  notes             String?
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, isDeleted])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, taxNumber])
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  SHIPPING
  LABOR
  DISCOUNT
  CUSTOM
}

model CatalogCategory {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Unit {
  id       String  @id @default(cuid())
  name     String
  symbol   String  @unique
  isActive Boolean @default(true)

  items CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model TaxRate {
  id         String  @id @default(cuid())
  companyId  String?
  name       String
  percentage Decimal @db.Decimal(5, 2)
  isSystem   Boolean @default(false)
  isActive   Boolean @default(true)

  company Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CatalogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isSystem])
  @@index([isActive])
}

model CatalogItem {
  id String @id @default(cuid())

  companyId String

  categoryId String?

  unitId String?

  taxRateId String?

  type CatalogItemType

  code    String
  sku     String?
  barcode String?

  name        String
  description String?

  purchasePrice Decimal? @db.Decimal(18, 3)
  salePrice     Decimal  @db.Decimal(18, 3)

  trackInventory Boolean @default(true)
  allowDiscount  Boolean @default(true)

  imageUrl String?
  notes    String?

  isActive Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category CatalogCategory? @relation(fields: [categoryId], references: [id])

  unit Unit? @relation(fields: [unitId], references: [id])

  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  priceListItems PriceListItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([barcode])
}

model PriceList {
  id           String  @id @default(cuid())
  companyId    String
  code         String
  name         String
  currencyCode String  @default("KWD")
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PriceListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, isDefault])
  @@index([companyId, isActive])
}

model PriceListItem {
  id            String  @id @default(cuid())
  priceListId   String
  catalogItemId String
  price         Decimal @db.Decimal(18, 3)

  priceList   PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priceListId, catalogItemId])
  @@index([priceListId])
  @@index([catalogItemId])
}
