DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/voka?schema=public"
SHADOW_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/voka_shadow?schema=public"
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3000"
VOKA_PUBLIC_URL="http://localhost:3000"
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET"
JWT_ISSUER="VOKA"
JWT_AUDIENCE="VOKA-WEB"

VOKA_EMAIL_PROVIDER=""
RESEND_API_KEY=""
VOKA_EMAIL_FROM="no-reply@example.invalid"
VOKA_CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

VOKA_WHATSAPP_PROVIDER=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_GRAPH_API_VERSION=""
META_WHATSAPP_TEMPLATE_AR=""
META_WHATSAPP_TEMPLATE_EN=""
META_WHATSAPP_TEMPLATE_LANGUAGE_AR=""
META_WHATSAPP_TEMPLATE_LANGUAGE_EN=""

# ── AI Model Routing (Phase 6.3) ────────────────────────────────────────────
# Ollama endpoint (shared by all Ollama-based AI features)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Sales AI — primary (cloud) + local fallback
# Cloud models must end with :cloud (e.g. minimax-m3:cloud).
# They automatically use cloud-compatible options (no format:json, no num_predict ceiling).
VOKA_SALES_AI_MODEL="minimax-m3:cloud"
VOKA_SALES_AI_FALLBACK_MODEL="qwen3:1.7b"
# Optional: override cloud timeout (ms). Default: 45000.
# VOKA_SALES_AI_CLOUD_TIMEOUT_MS=45000

# Translation — primary (cloud) + local fallback
VOKA_TRANSLATION_PROVIDER="ollama"
VOKA_TRANSLATION_MODEL="minimax-m3:cloud"
VOKA_TRANSLATION_FALLBACK_MODEL="qwen3:1.7b"
# Optional: override cloud timeout (ms). Default: 45000.
# VOKA_TRANSLATION_CLOUD_TIMEOUT_MS=45000
# Optional: override local translation timeout (ms). Default: 60000.
# VOKA_TRANSLATION_TIMEOUT_MS=60000

# Optional cloud translation providers (server-side only)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
VOKA_COMMERCIAL_RESEARCH_ENABLED="true"
# Optional bounded server-side web research controls; defaults shown.
# VOKA_COMMERCIAL_RESEARCH_MODEL=""
# VOKA_COMMERCIAL_RESEARCH_TIMEOUT_MS=20000
# VOKA_COMMERCIAL_RESEARCH_CACHE_TTL_MS=3600000
# VOKA_COMMERCIAL_RESEARCH_MAX_CALLS=2
# VOKA_COMMERCIAL_RESEARCH_MAX_SOURCES=6
# VOKA_COMMERCIAL_RESEARCH_MIN_EVIDENCE=1
# VOKA_COMMERCIAL_RESEARCH_PREFERRED_DOMAINS=""
# VOKA_COMMERCIAL_RESEARCH_BLOCKED_DOMAINS=""
VOKA_TRANSLATION_OPENAI_MODEL=""
GEMINI_API_KEY=""
GEMINI_TRANSLATION_MODEL=""
GOOGLE_CLOUD_TRANSLATION_API_KEY=""

# ── PDF OCR (Phase 2A-2B, scanned/image pages) ─────────────────────────────────
# Real local OCR: pdf.js rasterization + tesseract.js recognition (npm-only, offline).
# Unset/off = native-only analysis (scanned pages stay unread, truthfully reported).
VOKA_OCR_ENGINE="tesseract"
# Language data: "eng", or "eng+ara" when @tesseract.js-data/ara is installed.
VOKA_OCR_LANGS="eng"
# Cap on OCR-eligible pages per analysis (default 25).
# VOKA_OCR_MAX_PAGES=25
# Per-page recognition timeout in ms (default 180000).
# VOKA_OCR_TIMEOUT_MS=180000
# Optional writable cache for the tesseract worker (default .voka-cache/tesseract).
# VOKA_OCR_CACHE_DIR=""

# ── Vision (Phase 2A-3): semantic image/screenshot understanding ────────────
# OpenAI-compatible /chat/completions vision (works with OpenAI, Azure, vLLM,
# OpenRouter, or local Ollama /v1 with a vision model such as llama3.2-vision).
# Unset/off = visual inspection unavailable (images stay undescribed, truthfully reported).
# VOKA_VISION_PROVIDER="openai-compatible"
# VOKA_VISION_BASE_URL="https://api.openai.com/v1"
# VOKA_VISION_API_KEY=""
# VOKA_VISION_MODEL=""
# Per-request vision timeout in ms (default 60000).
# VOKA_VISION_TIMEOUT_MS=60000
# Images larger than this are never sent to the provider (default 5242880 = 5 MB).
# VOKA_VISION_MAX_IMAGE_BYTES=5242880

# ── Drawing semantic intelligence (Phase 2A-4) ───────────────────────────────
# Gated drawing reading reuses the vision provider above; there is no separate
# drawing provider. Pages qualify only through explicit drawing evidence;
# these limits bound cost, memory, and response size.
# Max qualified drawing pages rasterized + sent to vision per inspection
# (default 4, hard cap 10).
# VOKA_DRAWING_MAX_PAGES=4
# Rasterized drawing pages above this byte size are never sent (default 5242880).
# VOKA_DRAWING_MAX_IMAGE_BYTES=5242880
# Render scale for drawing pages, 1.0 = 72 DPI (default 2.5).
# VOKA_DRAWING_RASTER_SCALE=2.5
# Longest rendered edge in px; larger pages are downscaled (default 5000, cap 8000).
# VOKA_DRAWING_RASTER_MAX_DIMENSION_PX=5000

# ── Legacy / backward-compatible configuration ──────────────────────────────
# These are still respected when the new VOKA_SALES_AI_MODEL /
# VOKA_TRANSLATION_MODEL variables are not set.
# VOKA_AI_PROVIDER="ollama"
# OLLAMA_MODEL="qwen3:1.7b"
# VOKA_AI_TIMEOUT_MS=30000
