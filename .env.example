DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/voka?schema=public"
SHADOW_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/voka_shadow?schema=public"
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3000"
VOKA_PUBLIC_URL="http://localhost:3000"

VOKA_EMAIL_PROVIDER=""
RESEND_API_KEY=""
VOKA_EMAIL_FROM="no-reply@example.invalid"

VOKA_WHATSAPP_PROVIDER=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_GRAPH_API_VERSION=""
META_WHATSAPP_TEMPLATE_AR=""
META_WHATSAPP_TEMPLATE_EN=""
META_WHATSAPP_TEMPLATE_LANGUAGE_AR=""
META_WHATSAPP_TEMPLATE_LANGUAGE_EN=""

# ── AI Model Routing (Phase 6.3) ────────────────────────────────────────────
# Ollama endpoint (shared by all Ollama-based AI features)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Sales AI — primary (cloud) + local fallback
# Cloud models must end with :cloud (e.g. minimax-m3:cloud).
# They automatically use cloud-compatible options (no format:json, no num_predict ceiling).
VOKA_SALES_AI_MODEL="minimax-m3:cloud"
VOKA_SALES_AI_FALLBACK_MODEL="qwen3:1.7b"
# Optional: override cloud timeout (ms). Default: 45000.
# VOKA_SALES_AI_CLOUD_TIMEOUT_MS=45000

# Translation — primary (cloud) + local fallback
VOKA_TRANSLATION_MODEL="minimax-m3:cloud"
VOKA_TRANSLATION_FALLBACK_MODEL="qwen3:1.7b"
# Optional: override cloud timeout (ms). Default: 45000.
# VOKA_TRANSLATION_CLOUD_TIMEOUT_MS=45000
# Optional: override local translation timeout (ms). Default: 60000.
# VOKA_TRANSLATION_TIMEOUT_MS=60000

# ── Legacy / backward-compatible configuration ──────────────────────────────
# These are still respected when the new VOKA_SALES_AI_MODEL /
# VOKA_TRANSLATION_MODEL variables are not set.
# VOKA_AI_PROVIDER="ollama"
# OLLAMA_MODEL="qwen3:1.7b"
# VOKA_AI_TIMEOUT_MS=30000
